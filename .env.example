PORT=7860
HOST=127.0.0.1            # bind address; set 0.0.0.0 to expose on the network (adds risk — no auth)
PYTHON_BIN=python

# Subprocess governance
PY_TIMEOUT_MS=30000       # kill a Python report process after this many ms
PY_MAX_CONCURRENCY=       # max concurrent Python processes (blank = CPU count)

# Required for the AI chat tab — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:7860
OPENROUTER_APP_NAME=Mahadashboard

OPEN_BROWSER=true
