function openPlanetInterpretationModal(payload) {
  if (!payload?.planet_key || !state.chart || !state.context) return;
  const planetKey = payload.planet_key;
  const isRu = state.lang === "ru";
  const division = payload.division === "D9" ? (isRu ? "D9 Навамша" : "D9 Navamsa") : "D1 Rashi";
  const planetMeta = PLANET_META[planetKey] || { label: cap(planetKey) };
  const d1Planet = state.chart.planets?.[planetKey] || null;
  const d9Planet = state.chart.divisional_charts?.D9?.planets?.[planetKey] || null;

  const interpretationKeys = [];
  if (d1Planet?.clickable_keys?.length) interpretationKeys.push(...d1Planet.clickable_keys);
  if (payload.division === "D9" && d9Planet?.clickable_key) interpretationKeys.unshift(d9Planet.clickable_key);
  if (!interpretationKeys.length) interpretationKeys.push(`planet:${planetKey}`);
  const uniqueKeys = [...new Set(interpretationKeys)];

  const foundByKey = new Map();
  for (const key of uniqueKeys) {
    const matches = (state.context.items || []).filter((item) => item.key === key);
    if (matches.length) foundByKey.set(key, matches);
  }
  const foundItems = uniqueKeys.flatMap((key) => foundByKey.get(key) || []);
  const dedupedSources = [];
  const seen = new Set();
  for (const item of foundItems) {
    const signature = `${item.key}::${item.source_id}::${item.text}`;
    if (seen.has(signature)) continue;
    seen.add(signature);
    dedupedSources.push(item);
  }

  const missingEntries = uniqueKeys
    .filter((key) => !foundByKey.has(key))
    .map((key) => (state.context.missing || []).find((item) => item.key === key) || { key, message: MISSING_SOURCE_MSG });

  const titleEl = $("#planetModalTitle");
  const bodyEl = $("#planetModalBody");
  const modalEl = $("#planetModal");
  if (!titleEl || !bodyEl || !modalEl) return;

  titleEl.textContent = `${planetMeta.label} · ${division}`;

  const facts = [];
  if (d1Planet) {
    facts.push([isRu ? "D1 знак" : "D1 sign", localizeSign(d1Planet.sign)]);
    facts.push([isRu ? "D1 дом" : "D1 house", d1Planet.house ?? "missing"]);
    facts.push([isRu ? "D1 градус" : "D1 degree", d1Planet.degree_formatted || "missing"]);
    facts.push([isRu ? "D1 накшатра" : "D1 nakshatra", `${d1Planet.nakshatra || "missing"}${d1Planet.pada ? (isRu ? ` / пада ${d1Planet.pada}` : ` / pada ${d1Planet.pada}`) : ""}`]);
    facts.push([isRu ? "Ретроградность" : "Retrograde", d1Planet.retrograde ? (isRu ? "да" : "yes") : isRu ? "нет" : "no"]);
    facts.push([isRu ? "Управляет домами" : "Rules houses", (d1Planet.ruler_of_houses || []).join(", ") || (isRu ? "нет" : "none")]);
    facts.push([isRu ? "Достоинство" : "Dignity", localizeDignity(d1Planet.dignity)]);
  }
  if (d9Planet) {
    facts.push([isRu ? "D9 знак" : "D9 sign", localizeSign(d9Planet.sign)]);
    if (d9Planet.clickable_key) {
      facts.push([isRu ? "D9 ключ" : "D9 key", d9Planet.clickable_key]);
    }
  }

  const factsHtml = facts.length
    ? `
      <section class="planet-modal-section">
        <h4>${isRu ? "Расчётные факты" : "Calculated facts"}</h4>
        <dl class="planet-modal-facts">
          ${facts
            .map(
              ([label, value]) =>
                `<div class="planet-modal-fact"><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`
            )
            .join("")}
        </dl>
      </section>
    `
    : "";

  const sourceHtml = dedupedSources.length
    ? `
      <section class="planet-modal-section">
        <h4>${isRu ? "Трактовки из локальных источников" : "Interpretation from local sources"}</h4>
        <div class="planet-modal-source-id">${isRu ? "Тексты источников в этой сборке доступны на английском." : "Source texts in this build are available in English."}</div>
        ${dedupedSources
          .map(
            (item) => `
              <article class="planet-modal-source">
                <div class="planet-modal-source-key">${escapeHtml(item.key)}</div>
                <div class="planet-modal-source-id">${escapeHtml(item.source_id)} · ${escapeHtml(sourceLangLabel(item.source_id))}</div>
                <p class="planet-modal-source-text">${escapeHtml(item.text)}</p>
              </article>
            `
          )
          .join("")}
      </section>
    `
    : "";

  const keysHtml = `
      <section class="planet-modal-section">
        <h4>${isRu ? "Ключи интерпретации" : "Interpretation keys"}</h4>
        ${uniqueKeys.map((key) => `<div class="planet-modal-source-id">${escapeHtml(key)}</div>`).join("")}
      </section>
    `;

  const missingHtml = missingEntries.length
    ? `
      <section class="planet-modal-section">
        <h4>${isRu ? "Отсутствующие ключи" : "Missing keys"}</h4>
        ${missingEntries
          .map(
            (item) => `
              <div class="planet-modal-missing">
                <div>${escapeHtml(item.key)}</div>
                <div>${escapeHtml(localizeMissingMessage(item.message || MISSING_SOURCE_MSG))}</div>
              </div>
            `
          )
          .join("")}
      </section>
    `
    : "";

  bodyEl.innerHTML = factsHtml + sourceHtml + keysHtml + missingHtml;
  modalEl.classList.remove("hidden");
}
